{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated engineer profile and personal preferences.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID."
        },
        "displayName": {
          "type": "string",
          "maxLength": 120,
          "description": "User display name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254,
          "description": "Verified Google account email."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 1000,
          "description": "Optional profile avatar URL."
        },
        "lastPicName": {
          "type": "string",
          "maxLength": 120,
          "description": "Last responsible PIC name used during UMH Refresh."
        },
        "pendingMasterSync": {
          "type": "boolean",
          "description": "Legacy personal pending master sync preference."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": ["uid", "email", "pendingMasterSync", "createdAt", "updatedAt"]
    },
    "MasterConfig": {
      "title": "MasterConfig",
      "description": "Shared team STD parameters, 2D process matrices, Auto-Cut list, and Feeder list.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Initial creator Firebase Auth UID."
        },
        "params": {
          "type": "array",
          "description": "Standard process parameters list (max 300)."
        },
        "acMatrixMap": {
          "type": "object",
          "description": "Autocutting 2D matrix stored as row-keyed numeric arrays."
        },
        "saMatrixMap": {
          "type": "object",
          "description": "Semi-autocutting 2D matrix stored as row-keyed numeric arrays."
        },
        "mcMatrixMap": {
          "type": "object",
          "description": "Manual-(Air)cutting 2D matrix stored as row-keyed numeric arrays."
        },
        "cotMatrixMap": {
          "type": "object",
          "description": "COT taping V2 2D factor matrix (Master_COT_V2, D7..D36) stored as row-keyed numeric arrays."
        },
        "difficultyMatrixMap": {
          "type": "object",
          "description": "Manual difficulty rating percentage addition matrix (0.0..5.0 stars) stored as row-keyed numeric arrays."
        },
        "autoCutList": {
          "type": "array",
          "description": "Auto-cut terminal validation list (max 2000)."
        },
        "feederList": {
          "type": "array",
          "description": "Wire seal feeder validation list (max 2000)."
        },
        "pendingMasterSync": {
          "type": "boolean",
          "description": "Whether shared master STD/Auto-Cut/Feeder changes are pending UMH Refresh."
        },
        "updatedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the Google user who last modified shared master config."
        },
        "updatedByName": {
          "type": "string",
          "maxLength": 120,
          "description": "Display name of the Google user who last modified shared master config."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": [
        "ownerId",
        "params",
        "acMatrixMap",
        "saMatrixMap",
        "mcMatrixMap",
        "autoCutList",
        "feederList",
        "createdAt",
        "updatedAt"
      ]
    },
    "AssyRecord": {
      "title": "AssyRecord",
      "description": "Shared wire harness Assy configuration, BOM/PPCS/COT inputs, user attribution, and calculated UMH snapshot.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique Assy record ID."
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Initial creator Firebase Auth UID."
        },
        "assyNo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Assy part number."
        },
        "assyNoNormalized": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Lowercased trimmed Assy part number for duplicate detection."
        },
        "customer": {
          "type": "string",
          "maxLength": 120,
          "description": "Customer name."
        },
        "params": {
          "type": "object",
          "description": "Assy production and allowance parameters."
        },
        "assemblyComponents": {
          "type": "object",
          "description": "Additional assembly component quantities."
        },
        "partList": {
          "type": "array",
          "description": "Parsed Part List BOM rows (max 2000)."
        },
        "ppcsList": {
          "type": "array",
          "description": "Parsed PPCS wire circuit rows (max 5000)."
        },
        "assemblyCotList": {
          "type": "array",
          "description": "Parsed Assembly COT/Taping/Bare rows (max 1500)."
        },
        "terminalRatios": {
          "type": "object",
          "description": "Auto-cut terminal allocation percentage map."
        },
        "calculation": {
          "type": "object",
          "description": "Calculated Base Cycle Time & Standard UMH breakdown."
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Google Auth UID of the user who created this Assy."
        },
        "createdByName": {
          "type": "string",
          "maxLength": 120,
          "description": "Google display name of the user who created this Assy."
        },
        "createdByEmail": {
          "type": "string",
          "maxLength": 254,
          "description": "Google email of the user who created this Assy."
        },
        "updatedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Google Auth UID of the user who last updated this Assy."
        },
        "updatedByName": {
          "type": "string",
          "maxLength": 120,
          "description": "Google display name of the user who last updated this Assy."
        },
        "updatedByEmail": {
          "type": "string",
          "maxLength": 254,
          "description": "Google email of the user who last updated this Assy."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": [
        "id",
        "ownerId",
        "assyNo",
        "customer",
        "params",
        "assemblyComponents",
        "partList",
        "ppcsList",
        "assemblyCotList",
        "terminalRatios",
        "calculation",
        "createdAt",
        "updatedAt"
      ]
    },
    "RefreshHistoryEntry": {
      "title": "RefreshHistoryEntry",
      "description": "Shared audit log of UMH Refresh runs, master updates, and manual Assy edits.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique refresh log ID."
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Creator Firebase Auth UID."
        },
        "refreshedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server execution timestamp."
        },
        "responsibleName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Person in charge (Google user name) of the update or refresh."
        },
        "totalSelectedCount": {
          "type": "number",
          "description": "Number of items/Assys selected."
        },
        "affectedAssyCount": {
          "type": "number",
          "description": "Number of items/Assys modified."
        },
        "unaffectedAssyCount": {
          "type": "number",
          "description": "Number of items/Assys unchanged."
        },
        "affectedDiffs": {
          "type": "array",
          "description": "Affected-only diffs or master/manual Assy edit log payload (max 500)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": [
        "id",
        "ownerId",
        "refreshedAt",
        "responsibleName",
        "totalSelectedCount",
        "affectedAssyCount",
        "unaffectedAssyCount",
        "affectedDiffs",
        "createdAt"
      ]
    },
    "RecycleBinItem": {
      "title": "RecycleBinItem",
      "description": "Shared soft-deleted record stored in Firebase recycleBin directory for restore or permanent deletion.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique recycle bin document ID."
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Deleter Firebase Auth UID."
        },
        "itemType": {
          "type": "string",
          "enum": [
            "assy_record",
            "refresh_history",
            "auto_cut_item",
            "feeder_item"
          ],
          "description": "Category of soft-deleted entity."
        },
        "originalCollection": {
          "type": "string",
          "enum": ["assyRecords", "refreshHistory", "masterConfigs"],
          "description": "Original Firestore collection path."
        },
        "originalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Original ID of the deleted record or master item."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Primary display title for the deleted item."
        },
        "subtitle": {
          "type": "string",
          "maxLength": 240,
          "description": "Secondary metadata summary for the deleted item."
        },
        "payload": {
          "type": "object",
          "description": "Full snapshot payload required to restore the item."
        },
        "deletedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the item was moved to Recycle Bin."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": [
        "id",
        "ownerId",
        "itemType",
        "originalCollection",
        "originalId",
        "title",
        "subtitle",
        "payload",
        "deletedAt",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Per-user private workspace profile and preferences."
    },
    "/masterConfigs/{configId}": {
      "schema": {
        "$ref": "#/entities/MasterConfig"
      },
      "description": "Shared team Master STD database ('shared') plus legacy per-user fallback."
    },
    "/assyRecords/{recordId}": {
      "schema": {
        "$ref": "#/entities/AssyRecord"
      },
      "description": "Shared Wire Harness Assy records and UMH snapshots with Google user attribution."
    },
    "/refreshHistory/{historyId}": {
      "schema": {
        "$ref": "#/entities/RefreshHistoryEntry"
      },
      "description": "Shared audit history logs for UMH Refresh, Master edits, and manual Assy edits."
    },
    "/recycleBin/{itemId}": {
      "schema": {
        "$ref": "#/entities/RecycleBinItem"
      },
      "description": "Shared Recycle Bin storing soft-deleted Assy records, refresh history logs, and master items."
    }
  }
}
