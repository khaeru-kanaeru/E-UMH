rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Shared Hardened Primitives
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprints
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'pendingMasterSync', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'photoURL',
          'lastPicName',
          'pendingMasterSync',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000))
        && (!('lastPicName' in data) || (data.lastPicName is string && data.lastPicName.size() <= 120))
        && data.pendingMasterSync is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMasterConfig(data) {
      return data.keys().hasAll([
          'ownerId',
          'params',
          'acMatrixMap',
          'saMatrixMap',
          'mcMatrixMap',
          'autoCutList',
          'feederList',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'params',
          'acMatrixMap',
          'saMatrixMap',
          'mcMatrixMap',
          'cotMatrixMap',
          'difficultyMatrixMap',
          'autoCutList',
          'feederList',
          'pendingMasterSync',
          'updatedByUid',
          'updatedByName',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.ownerId)
        && (!('pendingMasterSync' in data) || data.pendingMasterSync is bool)
        && (!('updatedByUid' in data) || isValidId(data.updatedByUid))
        && (!('updatedByName' in data) || (data.updatedByName is string && data.updatedByName.size() <= 120))
        && data.params is list && data.params.size() <= 300
        && (data.params.size() == 0 || data.params[0] is map)
        && data.acMatrixMap is map
        && data.saMatrixMap is map
        && data.mcMatrixMap is map
        && (!('cotMatrixMap' in data) || data.cotMatrixMap is map)
        && (!('difficultyMatrixMap' in data) || data.difficultyMatrixMap is map)
        && data.autoCutList is list && data.autoCutList.size() <= 2000
        && (data.autoCutList.size() == 0 || data.autoCutList[0] is map)
        && data.feederList is list && data.feederList.size() <= 2000
        && (data.feederList.size() == 0 || data.feederList[0] is map)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAssyRecord(data) {
      return data.keys().hasAll([
          'id',
          'ownerId',
          'assyNo',
          'customer',
          'params',
          'assemblyComponents',
          'partList',
          'ppcsList',
          'assemblyCotList',
          'terminalRatios',
          'calculation',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'ownerId',
          'assyNo',
          'assyNoNormalized',
          'customer',
          'params',
          'assemblyComponents',
          'partList',
          'ppcsList',
          'assemblyCotList',
          'terminalRatios',
          'calculation',
          'createdByUid',
          'createdByName',
          'createdByEmail',
          'updatedByUid',
          'updatedByName',
          'updatedByEmail',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.ownerId)
        && data.assyNo is string && data.assyNo.size() >= 1 && data.assyNo.size() <= 120
        && (!('assyNoNormalized' in data) || (data.assyNoNormalized is string && data.assyNoNormalized.size() >= 1 && data.assyNoNormalized.size() <= 120))
        && data.customer is string && data.customer.size() <= 120
        && (!('createdByUid' in data) || isValidId(data.createdByUid))
        && (!('createdByName' in data) || (data.createdByName is string && data.createdByName.size() <= 120))
        && (!('createdByEmail' in data) || (data.createdByEmail is string && data.createdByEmail.size() <= 254))
        && (!('updatedByUid' in data) || isValidId(data.updatedByUid))
        && (!('updatedByName' in data) || (data.updatedByName is string && data.updatedByName.size() <= 120))
        && (!('updatedByEmail' in data) || (data.updatedByEmail is string && data.updatedByEmail.size() <= 254))
        && data.params is map
        && data.assemblyComponents is map
        && data.partList is list && data.partList.size() <= 2000
        && (data.partList.size() == 0 || data.partList[0] is map)
        && data.ppcsList is list && data.ppcsList.size() <= 5000
        && (data.ppcsList.size() == 0 || data.ppcsList[0] is map)
        && data.assemblyCotList is list && data.assemblyCotList.size() <= 1500
        && (data.assemblyCotList.size() == 0 || data.assemblyCotList[0] is map)
        && data.terminalRatios is map
        && data.calculation is map
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRefreshHistory(data) {
      return data.keys().hasAll([
          'id',
          'ownerId',
          'refreshedAt',
          'responsibleName',
          'totalSelectedCount',
          'affectedAssyCount',
          'unaffectedAssyCount',
          'affectedDiffs',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'id',
          'ownerId',
          'refreshedAt',
          'responsibleName',
          'totalSelectedCount',
          'affectedAssyCount',
          'unaffectedAssyCount',
          'affectedDiffs',
          'createdAt'
        ])
        && isValidId(data.id)
        && isValidId(data.ownerId)
        && data.responsibleName is string && data.responsibleName.size() >= 1 && data.responsibleName.size() <= 120
        && data.totalSelectedCount is number && data.totalSelectedCount >= 0 && data.totalSelectedCount <= 1000
        && data.affectedAssyCount is number && data.affectedAssyCount >= 0 && data.affectedAssyCount <= 1000
        && data.unaffectedAssyCount is number && data.unaffectedAssyCount >= 0 && data.unaffectedAssyCount <= 1000
        && data.affectedDiffs is list && data.affectedDiffs.size() <= 500
        && (data.affectedDiffs.size() == 0 || data.affectedDiffs[0] is map)
        && data.refreshedAt is timestamp
        && data.createdAt is timestamp;
    }

    function isValidRecycleBinItem(data) {
      return data.keys().hasAll([
          'id',
          'ownerId',
          'itemType',
          'originalCollection',
          'originalId',
          'title',
          'subtitle',
          'payload',
          'deletedAt',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'id',
          'ownerId',
          'itemType',
          'originalCollection',
          'originalId',
          'title',
          'subtitle',
          'payload',
          'deletedAt',
          'createdAt'
        ])
        && isValidId(data.id)
        && isValidId(data.ownerId)
        && data.itemType in ['assy_record', 'refresh_history', 'auto_cut_item', 'feeder_item']
        && data.originalCollection in ['assyRecords', 'refreshHistory', 'masterConfigs']
        && isValidId(data.originalId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.subtitle is string && data.subtitle.size() <= 240
        && data.payload is map
        && data.deletedAt is timestamp
        && data.createdAt is timestamp;
    }

    // Collection 1: users/{userId} (strictly owner-only PII)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;
      allow create: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'email',
          'photoURL',
          'lastPicName',
          'pendingMasterSync',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    // Collection 2: masterConfigs/{configId} (shared workspace config 'shared' + legacy per-user fallback)
    match /masterConfigs/{configId} {
      allow get: if isSignedIn()
        && isValidId(configId)
        && (configId == 'shared' || configId == request.auth.uid);
      allow list: if false;
      allow create: if isSignedIn()
        && isValidId(configId)
        && (configId == 'shared' || configId == request.auth.uid)
        && isValidMasterConfig(incoming())
        && incoming().ownerId == request.auth.uid
        && (!('updatedByUid' in incoming()) || incoming().updatedByUid == request.auth.uid)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(configId)
        && (configId == 'shared' || configId == request.auth.uid)
        && isValidMasterConfig(incoming())
        && incoming().ownerId == existing().ownerId
        && (!('updatedByUid' in incoming()) || incoming().updatedByUid == request.auth.uid)
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'params',
          'acMatrixMap',
          'saMatrixMap',
          'mcMatrixMap',
          'cotMatrixMap',
          'difficultyMatrixMap',
          // Legacy fields allowed in diff ONLY so deleteField() can strip them (rejected in incoming() by isValidMasterConfig)
          'settingWireMatrixMap',
          'processDiscs',
          'autoCutList',
          'feederList',
          'pendingMasterSync',
          'updatedByUid',
          'updatedByName',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    // Collection 3: assyRecords/{recordId} (shared across all verified Google accounts)
    match /assyRecords/{recordId} {
      allow get: if isSignedIn() && isValidId(recordId);
      allow list: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(recordId)
        && isValidAssyRecord(incoming())
        && incoming().id == recordId
        && incoming().ownerId == request.auth.uid
        && (!('createdByUid' in incoming()) || incoming().createdByUid == request.auth.uid)
        && (!('updatedByUid' in incoming()) || incoming().updatedByUid == request.auth.uid)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(recordId)
        && isValidAssyRecord(incoming())
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && (!('createdByUid' in existing()) || incoming().createdByUid == existing().createdByUid)
        && (!('updatedByUid' in incoming()) || incoming().updatedByUid == request.auth.uid)
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'assyNo',
          'assyNoNormalized',
          'customer',
          'params',
          'assemblyComponents',
          'partList',
          'ppcsList',
          'assemblyCotList',
          'terminalRatios',
          'calculation',
          'createdByUid',
          'createdByName',
          'createdByEmail',
          'updatedByUid',
          'updatedByName',
          'updatedByEmail',
          'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidId(recordId);
    }

    // Collection 4: refreshHistory/{historyId} (shared append-only audit log across all verified Google accounts)
    match /refreshHistory/{historyId} {
      allow get: if isSignedIn() && isValidId(historyId);
      allow list: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(historyId)
        && isValidRefreshHistory(incoming())
        && incoming().id == historyId
        && incoming().ownerId == request.auth.uid
        && incoming().refreshedAt == request.time
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isSignedIn() && isValidId(historyId);
    }

    // Collection 5: recycleBin/{itemId} (shared recycle bin across all verified Google accounts)
    match /recycleBin/{itemId} {
      allow get: if isSignedIn() && isValidId(itemId);
      allow list: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(itemId)
        && isValidRecycleBinItem(incoming())
        && incoming().id == itemId
        && incoming().ownerId == request.auth.uid
        && incoming().deletedAt == request.time
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isSignedIn() && isValidId(itemId);
    }
  }
}
